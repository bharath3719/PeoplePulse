{
  "name": "peoplepulse",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud HRMS for Indian SMBs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @peoplepulse/db",
    "db:migrate": "npm run migrate -w @peoplepulse/db",
    "db:seed": "npm run seed -w @peoplepulse/db",
    "dev:api": "npm run dev -w @peoplepulse/api",
    "dev:web": "npm run dev -w @peoplepulse/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
