{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declarationMap": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "incremental": false
  },
  "include": [
    "src/**/*"
  ]
}