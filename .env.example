# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Your local PostgreSQL on :5432. Create both databases first:
#   createdb -U postgres peoplepulse
#   createdb -U postgres peoplepulse_test
#
# Two roles, and the distinction is load-bearing (ADR-006):
#   *_MIGRATION_DATABASE_URL  connects as `postgres`, the owner. Runs DDL.
#   DATABASE_URL / TEST_*     connects as `peoplepulse_app`, which the migration
#                             creates with APP_DB_PASSWORD. NOSUPERUSER,
#                             NOBYPASSRLS. A superuser here means no tenant
#                             isolation at all, and the API refuses to boot.
#
# YOUR_PASSWORD is the one you set for `postgres` when you installed it.
# APP_PASSWORD is anything you choose; the migration sets it on the role.
APP_DB_PASSWORD=APP_PASSWORD
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/peoplepulse
DATABASE_URL=postgresql://peoplepulse_app:APP_PASSWORD@localhost:5432/peoplepulse

# A separate database for tests. The isolation suite deletes every tenant in it
# on each run, so it must NOT be the same as the one above.
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/peoplepulse_test
TEST_DATABASE_URL=postgresql://peoplepulse_app:APP_PASSWORD@localhost:5432/peoplepulse_test

# --- Auth (TR-50) ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-bytes-minimum
JWT_REFRESH_SECRET=change-me-different-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- PII encryption (TR-52) ----------------------------------------------
# AES-256-GCM key for PAN and bank account columns. In production this comes
# from cloud KMS with per-tenant data keys — this local key is for dev only.
PII_ENCRYPTION_KEY=change-me-32-byte-hex-key

# --- App ------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Also the base of the link in invitation emails.
WEB_ORIGIN=http://localhost:5173

# --- Mail -----------------------------------------------------------------
# SMTP for invitation emails, e.g. smtps://USER:PASS@email-smtp.ap-south-1.amazonaws.com:465
# Leave unset in development and mail is printed to the API log instead — the
# invitation link included. The API refuses to start without it in production.
SMTP_URL=
MAIL_FROM=PeoplePulse <no-reply@peoplepulse.in>
