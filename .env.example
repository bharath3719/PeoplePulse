# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Your local PostgreSQL 18 on :5432. Replace YOUR_PASSWORD with the password
# you set for the `postgres` user when you installed it.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/peoplepulse

# A separate database for tests. It gets DROPPED and recreated on every run,
# so it must NOT be the same as the one above.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/peoplepulse_test

# --- Auth (TR-50) ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-bytes-minimum
JWT_REFRESH_SECRET=change-me-different-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- PII encryption (TR-52) ----------------------------------------------
# AES-256-GCM key for PAN and bank account columns. In production this comes
# from cloud KMS with per-tenant data keys — this local key is for dev only.
PII_ENCRYPTION_KEY=change-me-32-byte-hex-key

# --- App ------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
